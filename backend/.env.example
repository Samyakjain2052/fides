# =============================================================================
# DataShield backend configuration. Copy to .env for local work.
#
# LOCAL DEMO VALUES ONLY. In any deployed environment these come from a secret
# manager, and the process refuses to start on a placeholder secret.
# =============================================================================

DS_ENV=dev
DS_DEBUG=true

# --- database ----------------------------------------------------------------
# TWO URLS, and the split is the security model:
#   DS_DATABASE_URL        the application. A restricted role that RLS applies to.
#   DS_DATABASE_OWNER_URL  migrations only. Owns the tables, so RLS does not
#                          constrain it.
# Running the app on the owner URL silently disables every isolation policy.
DS_DATABASE_URL=postgresql+asyncpg://datashield_app:apppassword@localhost:6543/datashield
DS_DATABASE_OWNER_URL=postgresql+asyncpg://datashield_owner:ownerpassword@localhost:6543/datashield

# --- secrets (32+ chars each) ------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Two separate keys on purpose. JWT signs sessions; AUDIT_HMAC_KEY signs the audit
# hash chain. Separate blast radius: leaking the session key does not let anyone
# forge history.
DS_JWT_SECRET=dev-only-jwt-secret-please-replace-me-32chars
DS_AUDIT_HMAC_KEY=dev-only-audit-hmac-key-please-replace-32chars

# --- session -----------------------------------------------------------------
DS_ACCESS_TOKEN_TTL_MINUTES=15
DS_REFRESH_TOKEN_TTL_DAYS=14
# false for local http. The config validator refuses to start prod with it off.
DS_COOKIE_SECURE=false

# --- CORS --------------------------------------------------------------------
# The CMS frontend. Never "*" with credentials enabled.
DS_CORS_ORIGINS=["http://localhost:5173"]

# --- argon2 cost -------------------------------------------------------------
DS_ARGON2_TIME_COST=3
DS_ARGON2_MEMORY_COST=65536
DS_ARGON2_PARALLELISM=4

# =============================================================================
# AZURE DATABASE FOR POSTGRESQL — FLEXIBLE SERVER
#
# Swap the two URLs above for these when pointing at Azure. Note there is NO
# `?sslmode=require` — that is a libpq parameter and asyncpg rejects it. TLS is
# configured with DS_DB_SSL_MODE below, which builds a real SSL context.
#
# DS_DATABASE_URL=postgresql+asyncpg://datashield_app:<app-pw>@<srv>.postgres.database.azure.com:5432/datashield
# DS_DATABASE_OWNER_URL=postgresql+asyncpg://datashield_owner:<owner-pw>@<srv>.postgres.database.azure.com:5432/datashield
#
# verify-full = encrypted AND the server's identity is checked. `require` alone
# encrypts but does not stop an active man-in-the-middle, so it is not enough for
# a remote database carrying personal data.
# DS_DB_SSL_MODE=verify-full
#
# Usually unnecessary — Azure's chain (DigiCert Global Root G2 / Microsoft RSA
# Root CA 2017) is in the system trust store. Set it to pin explicitly.
# DS_DB_SSL_ROOT_CERT=/etc/ssl/certs/DigiCertGlobalRootG2.crt.pem
#
# Requirements on the Azure side:
#   * PostgreSQL 16 or newer   (15 and earlier cannot manage BYPASSRLS as this
#                               schema requires — see docs/AZURE_DEPLOYMENT.md)
#   * scripts_bootstrap_azure.sql run once by the server admin
#   * a firewall rule or private endpoint that lets this app reach the server
# =============================================================================
DS_DB_SSL_MODE=disable
