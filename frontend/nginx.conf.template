# =============================================================================
# The single public ingress.
#
# Everything the browser talks to is served from ONE origin: the static app, the
# CMS API, and the DSAR gateway. That is not a tidiness preference — it is what
# makes authentication work at all.
#
# The backend sets its refresh cookie with SameSite=Strict. If the app were
# served from one hostname and the API from another, the browser would simply
# not send that cookie: sign-in would appear to succeed and every reload would
# drop the session, with nothing in any log to explain it. Relaxing to
# SameSite=None is not a fix — Safari's ITP and Brave block third-party cookies
# outright, so it would still be broken there, and we would additionally owe a
# CSRF token on every mutating request.
#
# Same-origin also removes the CORS surface completely.
#
# BACKEND_URL and GATEWAY_URL are substituted at container start by the
# nginx:alpine entrypoint (it runs envsubst over /etc/nginx/templates/*.template).
#
# WHY proxy_pass GOES THROUGH A VARIABLE
#
# nginx resolves an upstream hostname ONCE, at startup, and caches the address
# for the life of the process. Recreating the backend container gives it a new
# IP, and nginx keeps proxying to the old one: every request through /api
# returns 502 until nginx is restarted, while the backend stays perfectly
# healthy the whole time. That combination — healthy backend, 502 through the
# proxy, nothing in either log — is genuinely hard to diagnose, and it happened
# here during a routine `docker compose up --force-recreate cms-backend`.
#
# Putting the upstream in an nginx variable defeats the startup-time caching:
# nginx then resolves per request, using `resolver` below. The cost is one DNS
# lookup per request against a local cache, which is nothing next to a proxy
# that silently points at a dead container after every deploy.
#
# Because a variable proxy_pass does not apply the trailing-slash URI rewrite,
# each location states its path handling explicitly. Those rewrites are the
# reason this file has tests: getting one wrong reshapes a published contract.
# =============================================================================

server {
    # 8080, not 80: binding a privileged port would mean running as root, and
    # this container is the one thing exposed to the internet.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS by default; overridable because Azure Container Apps
    # and Kubernetes each publish their own. `valid=10s` bounds how long a stale
    # address can survive a container replacement — long enough to be a cache,
    # short enough that a deploy heals itself within a few seconds.
    #
    # ipv6=off because the compose network is v4-only and nginx would otherwise
    # spend every lookup waiting on an AAAA query that always fails.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 3s;

    # Uploads are capped here too, not only in the app. The edge is the only
    # place a limit cannot be bypassed by calling the API directly.
    client_max_body_size 10m;

    # --- security headers ----------------------------------------------------
    # A procurement reviewer will look for these, and they are cheap.
    add_header X-Content-Type-Options    "nosniff"          always;
    add_header X-Frame-Options           "DENY"             always;
    add_header Referrer-Policy           "same-origin"      always;
    add_header Cross-Origin-Opener-Policy "same-origin"     always;
    # HSTS is set at the TLS terminator, not here: this server also answers
    # plain HTTP health probes inside the cluster, and sending HSTS over those
    # would be meaningless at best.

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/xml font/woff font/woff2;

    # --- the CMS API ---------------------------------------------------------
    # Trailing slashes on both sides: /api/v1/auth/login -> /v1/auth/login
    location /api/ {
        # `rewrite ... break` plus a variable proxy_pass with no URI is the
        # documented equivalent of `proxy_pass ${BACKEND_URL}/;` — it strips the
        # /api prefix, and unlike the literal form it re-resolves the hostname.
        set                $cms_backend ${BACKEND_URL};
        rewrite            ^/api/(.*)$ /$1 break;
        proxy_pass         $cms_backend;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        # The backend marks its cookie Secure. Without this it cannot tell that
        # the original request arrived over TLS, and would refuse to set it.
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    # --- the public API ------------------------------------------------------
    # Customers' own systems call these paths, so unlike /api they are mounted at
    # the SAME path the backend serves (no prefix rewrite): a published contract
    # must not depend on this proxy's shape. Without this block the SPA fallback
    # answered /public/* with index.html — a 200 carrying HTML, which is the
    # worst possible failure for a machine caller.
    location /public/ {
        # $request_uri, not a rewrite: this path must reach the backend byte for
        # byte, query string included, because customers' systems are coded
        # against it.
        set                $cms_backend_public ${BACKEND_URL};
        proxy_pass         $cms_backend_public$request_uri;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }

    # --- the DSAR gateway ----------------------------------------------------
    # A privacy request is queued to a Celery worker and polled, so the timeout
    # is generous: a slow fan-out across four datastores is normal, not a fault.
    location /gateway/ {
        set                $dsar_gateway ${GATEWAY_URL};
        rewrite            ^/gateway/(.*)$ /$1 break;
        proxy_pass         $dsar_gateway;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout   300s;
    }

    # --- static assets -------------------------------------------------------
    # Vite fingerprints these, so the filename changes whenever the bytes do and
    # a year-long immutable cache is safe.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html must NOT be cached: it is the document that names the current
    # asset hashes. A stale one points at files that no longer exist, and the
    # app white-screens for anyone who visited before the deploy.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires -1;
    }

    # Liveness for the platform's probe. Deliberately not /health — that is the
    # gateway's, and two different meanings behind one path is how a green
    # dashboard ends up hiding a broken dependency.
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"cms-frontend"}';
    }

    # --- SPA fallback --------------------------------------------------------
    # Client-side routing: /roadmap, /admin/dsar and friends are not files on
    # disk. Anything unmatched returns index.html and React resolves the route.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
