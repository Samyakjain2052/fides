# Frontend build-time configuration.
#
# VITE_* variables are BAKED INTO THE BUNDLE and are therefore public. Never put
# a secret here — a secret in a Vite env var is a secret in your JavaScript.

# The publishable key the consent and cookie banners use.
#
# Public by design: it can only COLLECT consent (never withdraw, never read), it
# is pinned to an origin allowlist, and every record it creates carries
# server-observed provenance. See docs/PUBLISHABLE_KEY_SECURITY.md.
#
# Issue one from the console: Admin -> POST /v1/admin/publishable-keys, with the
# origins your site will actually run on.
VITE_PUBLISHABLE_KEY=pk_live_replace_me

# Stamped into the footer and the roadmap page so a running build names its commit.
VITE_BUILD_SHA=dev
