    "lint": "eslint src scripts --no-warn-ignored",
    "check:preview": "node scripts/check-preview-locks.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.15.0",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "vite": "5.4.8"
  }
}
