{
  "name": "datashield-cms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DataShield — DPDP Act 2023 Consent Management System (user + admin)",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && node scripts/check-preview-locks.mjs && vite build",
