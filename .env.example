# =============================================================================
# fides-dsar-demo — environment configuration
#
# Copy to .env before running `docker compose up`:
#     cp .env.example .env
#
# Every value below is a LOCAL DEMO credential. Do not reuse in a real
# deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# Fides image
# Pinned for reproducibility. See https://hub.docker.com/r/ethyca/fides/tags
# -----------------------------------------------------------------------------
FIDES_IMAGE_TAG=2.86.2

# -----------------------------------------------------------------------------
# Fides security / admin credentials
# Consumed by fides-config/fides.toml via ${VAR} interpolation and by the
# provisioner + gateway when they authenticate against the Fides API.
#
# FIDES_APP_ENCRYPTION_KEY *must* be exactly 32 characters — Fides uses it as an
# AES-256 key for connection secrets at rest.
# Docs: https://ethyca.com/docs/dev-docs/configuration/configuration#security
# -----------------------------------------------------------------------------
FIDES_APP_ENCRYPTION_KEY=demoencryptionkeydemoencryption1
FIDES_OAUTH_ROOT_CLIENT_ID=fidesadmin
FIDES_OAUTH_ROOT_CLIENT_SECRET=fidesadminsecret
FIDES_ROOT_USERNAME=root_user
FIDES_ROOT_PASSWORD=Testpassword1!

# -----------------------------------------------------------------------------
# Fides' own application database (NOT the app data being DSAR'd)
# -----------------------------------------------------------------------------
FIDES_DB_USER=postgres
FIDES_DB_PASSWORD=fidespassword
FIDES_DB_NAME=fides

# -----------------------------------------------------------------------------
# Fides' Redis (Celery broker + DSR result cache)
# -----------------------------------------------------------------------------
FIDES_REDIS_PASSWORD=redispassword

# -----------------------------------------------------------------------------
# app-postgres — the demo application database holding users + orders.
# These same values are handed to Fides as the postgres ConnectionConfig
# secrets by the provisioner (see fides-config/connections/connections.yml).
# -----------------------------------------------------------------------------
APP_POSTGRES_HOST=app-postgres
APP_POSTGRES_PORT=5432
APP_POSTGRES_DB=appdb
APP_POSTGRES_USER=appuser
APP_POSTGRES_PASSWORD=apppassword

# -----------------------------------------------------------------------------
# app-mongo — the demo application database holding the events collection.
#
# APP_MONGO_USER is created *inside* APP_MONGO_DB by
# app-mongo/init/00_create_app_user.sh, because Fides authenticates against the
# database named in `defaultauthdb` rather than against `admin`.
# The ROOT user exists only so that init script can run.
# -----------------------------------------------------------------------------
APP_MONGO_HOST=app-mongo
APP_MONGO_PORT=27017
# MUST match the fides_key of fides-config/resources/app_mongo_dataset.yml.
# Fides' mongodb connector queries the database named after the dataset key, not
# after this value — see the note at the top of that file. Renaming one without
# the other breaks every Mongo DSAR at execution time.
APP_MONGO_DB=app_mongo_dataset
APP_MONGO_ROOT_USER=mongoroot
APP_MONGO_ROOT_PASSWORD=mongorootpassword
APP_MONGO_USER=mongouser
APP_MONGO_PASSWORD=mongopassword

# -----------------------------------------------------------------------------
# fastapi-gateway
# FIDES_URL is the in-network address of the Fides server.
# The policy keys must match fides-config/policies/dsr_policies.yml.
# -----------------------------------------------------------------------------
FIDES_URL=http://fides:8080
ACCESS_POLICY_KEY=demo_access_policy
ERASURE_POLICY_KEY=demo_erasure_policy
GATEWAY_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Host port mappings (change these if something is already bound locally)
# -----------------------------------------------------------------------------
# Comments are kept on their own lines: inline `# ...` after a value is only
# stripped by Compose v2, and this file should also be safe to `source`.
#
# Fides API + Admin UI
FIDES_PORT=8080
# fastapi-gateway (Swagger at /docs)
GATEWAY_PORT=8000
# cms-frontend (DataShield CMS — the DPDP consent-management UI)
CMS_PORT=5173
# app data, reachable from the host with psql / mongosh
APP_POSTGRES_HOST_PORT=6432
APP_MONGO_HOST_PORT=37017
# Fides' own infrastructure, exposed only for debugging
FIDES_DB_HOST_PORT=7432
FIDES_REDIS_HOST_PORT=7379

# -----------------------------------------------------------------------------
# Demo data subject — seeded into BOTH databases
# -----------------------------------------------------------------------------
DEMO_EMAIL=demo@example.com

# -----------------------------------------------------------------------------
# DataShield CMS backend (backend/) — see backend/ARCHITECTURE.md
# Two separate secrets on purpose: JWT signs sessions, the HMAC key signs the
# audit hash chain. Leaking one must not compromise the other.
# -----------------------------------------------------------------------------
DS_JWT_SECRET=replace-me-with-48-random-bytes-min-32-chars
DS_AUDIT_HMAC_KEY=replace-me-with-48-random-bytes-min-32-chars
DS_COOKIE_SECURE=false
CMS_BACKEND_PORT=8100
CMS_DB_HOST_PORT=6543
CMS_DB_ROOT_PASSWORD=postgres
